---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CutsShowcase from '../components/CutsShowcase.astro';
import { site } from '../data/site';
import { press } from '../data/press';
---

<Base>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <canvas class="hero__embers" data-embers aria-hidden="true"></canvas>
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title" class="display hero__title">
          <span class="hero__mask"><span data-hero="1" data-hero-line>Steak</span></span>
          <span class="hero__mask"><span data-hero="2" data-hero-line>over</span></span>
          <span class="hero__mask"><span data-hero="3" data-hero-line><em>alder</em></span></span>
        </h1>
        <p class="hero__sub" data-hero="4">
          A wood-fired steakhouse in an 1890s brick building in Pioneer Square. Washington beef,
          dry-aged downstairs and cooked on an open hearth.
        </p>
        <div class="actions" data-hero="5">
          <a href="/reservations/" class="btn">Book a table</a>
          <a href="/menu/" class="btn btn--ghost">See the menu</a>
        </div>
        <p class="hero__hours small muted" data-hero="6">Tuesday to Sunday from 5 pm. Walk-ins welcome at the bar.</p>
      </div>

      <div class="hero__arch arch" data-hero="0" data-hero-arch>
        <Photo
          name="hero"
          alt="A bone-in steak on the grate over glowing alder coals"
          sizes="(min-width: 60rem) 40vw, 90vw"
          priority
        />
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <h2 id="intro-title" class="h1" data-reveal>
        Pioneer Square was rebuilt in brick after the fire of 1889. We put a fire back inside.
      </h2>
      <div class="intro__body">
        <p class="prose muted" data-reveal>
          There’s no gas line to our grill and no charcoal in the kitchen, only split Washington alder
          burning down to coals. It cooks hot, smells like the Northwest, and leaves a crust you can’t
          get any other way. The beef comes from family ranches east of the Cascades and ages in our
          basement until it’s ready.
        </p>
        <dl class="facts" data-reveal>
          <div>
            <dt>Dry-aged in house</dt>
            <dd>21 to 45 days</dd>
          </div>
          <div>
            <dt>Wine in the cellar</dt>
            <dd>600 bottles</dd>
          </div>
          <div>
            <dt>Fuel for the fire</dt>
            <dd>Alder, nothing else</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Cuts -->
  <section class="section cuts-section" aria-labelledby="cuts-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cuts-title" class="h1" data-reveal>From the fire</h2>
        <p class="muted" data-reveal>
          Five cuts, always on. Each comes with alder-smoked butter and flaky salt.
          <a class="link" href="/menu/">Full dinner menu</a>
        </p>
      </div>
      <CutsShowcase />
    </div>
  </section>

  <!-- Hearth -->
  <section class="hearth" aria-labelledby="hearth-quote">
    <div class="hearth__media" aria-hidden="true">
      <Photo
        name="hearth-wide"
        alt=""
        sizes="100vw"
        class="hearth__photo"
        mediaAttrs={{ 'data-parallax': '' }}
      />
    </div>
    <div class="wrap hearth__content">
      <figure>
        <blockquote id="hearth-quote" class="h2" data-reveal>
          “Alder burns hot and clean, and it smells like home. We built the whole kitchen around it,
          then built the dining room around the kitchen.”
        </blockquote>
        <figcaption data-reveal>
          Mara Ellison, chef and owner
        </figcaption>
      </figure>
      <a href="/story/" class="btn btn--ghost" data-reveal>Read our story</a>
    </div>
  </section>

  <!-- Press -->
  <section class="section press" aria-labelledby="press-title">
    <div class="wrap">
      <h2 id="press-title" class="visually-hidden">What critics have said</h2>
      <ul class="press__list" role="list">
        {
          press.map((p) => (
            <li data-reveal>
              <blockquote>“{p.quote}”</blockquote>
              <p class="press__source">
                {p.source}, {p.year}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="press__more"><a class="link" href="/gallery/#press">More press and awards</a></p>
    </div>
  </section>

  <!-- Private dining -->
  <section class="section private" aria-labelledby="private-title">
    <div class="wrap private__grid">
      <div class="private__photo arch" data-unveil>
        <Photo name="private-library" alt="The Library private dining room, set for dinner" sizes="(min-width: 60rem) 40vw, 90vw" />
      </div>
      <div class="private__copy">
        <h2 id="private-title" class="h1" data-reveal>A room of your own</h2>
        <p class="prose muted" data-reveal>
          Two private rooms seat from 8 to 22, and the whole restaurant takes up to 120 for a standing
          reception. Our events team handles the menu, the wine and the flowers, so you only have to
          show up.
        </p>
        <div class="actions" data-reveal>
          <a href="/private-dining/" class="btn">Plan an event</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit -->
  <section class="section visit" aria-labelledby="visit-title">
    <div class="wrap visit__grid">
      <div>
        <h2 id="visit-title" class="h1" data-reveal>Join us for dinner</h2>
        <p class="prose muted" data-reveal>
          We take reservations up to 60 days ahead. For parties of nine or more, our events team
          will help you plan.
        </p>
        <div class="actions" data-reveal>
          <a href="/reservations/" class="btn">Book a table</a>
          <a href={site.phoneHref} class="btn btn--ghost">Call {site.phone}</a>
        </div>
      </div>
      <div class="visit__info" data-reveal>
        <div>
          <h3 class="visit__h">Hours</h3>
          <dl class="hours">
            {
              site.hours.map((h) => (
                <div>
                  <dt>{h.days}</dt>
                  <dd>{h.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h3 class="visit__h">Address</h3>
          <address>
            {site.address.street}<br />
            {site.address.city}, {site.address.region} {site.address.postal}
          </address>
          <p><a class="link" href="/visit/">Parking and directions</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: var(--space-xl);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    inset: auto -20% -30% -20%;
    height: 70%;
    z-index: -1;
    background: radial-gradient(50% 60% at 60% 100%, rgb(224 119 58 / 0.22), transparent 70%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__glow {
      animation: breathe 7s ease-in-out infinite alternate;
    }
  }
  @keyframes breathe {
    to {
      opacity: 0.6;
      transform: scale(1.06);
    }
  }
  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-xl);
    }
  }
  .hero__title {
    display: grid;
    font-size: clamp(4rem, 2.2rem + 9vw, 10.5rem);
    line-height: 0.86;
  }
  .hero__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__mask > span {
    display: block;
  }
  .hero__title em {
    font-style: italic;
    color: var(--brass-bright);
  }
  .hero__sub {
    max-width: 30rem;
    margin-top: var(--space-l);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--smoke);
  }
  .hero .actions {
    margin-top: var(--space-l);
  }
  .hero__hours {
    margin-top: var(--space-m);
  }
  .hero__arch {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    box-shadow: 0 40px 120px -40px rgb(224 119 58 / 0.35);
  }
  @media (max-width: 59.99rem) {
    .hero__arch {
      max-width: 22rem;
    }
  }

  /* Intro */
  .intro__grid {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 60rem) {
    .intro__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
    .intro__body {
      padding-top: 0.75rem;
    }
  }
  .facts {
    margin-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    color: var(--smoke);
    font-size: 0.95rem;
  }
  .facts dd {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--bone);
    text-align: right;
  }

  /* Cuts */
  .cuts-section {
    padding-top: 0;
  }
  .section-head {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .section-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: end;
    }
    .section-head p {
      max-width: 30rem;
    }
  }

  /* Hearth */
  .hearth {
    position: relative;
    min-height: min(100svh, 56rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }
  .hearth__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hearth__media :global(.hearth__photo) {
    height: 100%;
    aspect-ratio: auto;
  }
  .hearth__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--soot) 0%, rgb(21 17 14 / 0.35) 35%, rgb(21 17 14 / 0.85) 100%);
  }
  .hearth__content {
    padding-block: var(--space-2xl);
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }
  .hearth blockquote {
    max-width: 24ch;
    font-style: italic;
    line-height: 1.15;
  }
  .hearth figcaption {
    margin-top: var(--space-m);
    color: var(--smoke);
  }

  /* Press */
  .press__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .press__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-l);
    }
  }
  .press__list li {
    padding-top: var(--space-m);
    border-top: 1px solid var(--line-strong);
  }
  .press blockquote {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
  }
  .press__source {
    margin-top: var(--space-s);
    color: var(--brass);
    font-size: 0.95rem;
  }
  .press__more {
    margin-top: var(--space-xl);
  }

  /* Private */
  .private {
    background: var(--oak);
  }
  .private__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .private__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
  .private__photo {
    max-width: 28rem;
    width: 100%;
  }
  .private__copy {
    display: grid;
    gap: var(--space-m);
  }

  /* Visit */
  .visit__grid {
    display: grid;
    gap: var(--space-xl);
  }
  .visit__grid > div:first-child {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  @media (min-width: 60rem) {
    .visit__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
  .visit__info {
    display: grid;
    gap: var(--space-l);
  }
  .visit__h {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brass);
    margin-bottom: var(--space-xs);
  }
  address {
    font-style: normal;
    margin-bottom: var(--space-2xs);
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .hours dt {
    color: var(--smoke);
  }
</style>
