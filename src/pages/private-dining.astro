---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import type { PhotoName } from '../data/photos';
import { site } from '../data/site';

const rooms: { id: string; name: string; photo: PhotoName; seated: string; standing?: string; minimum: string; text: string; arch: boolean }[] = [
  {
    id: 'library',
    name: 'The Library',
    photo: 'private-library',
    seated: 'Up to 22 seated',
    standing: '30 standing',
    minimum: 'From $2,500',
    text: 'One long walnut table under shelves of old cookbooks, with a window onto the hearth. Good for rehearsal dinners, team dinners and birthdays.',
    arch: true,
  },
  {
    id: 'cellar',
    name: 'The Cellar',
    photo: 'private-cellar',
    seated: 'Up to 8 seated',
    minimum: 'From $1,200',
    text: 'A single table set among six hundred bottles in the basement, next to the aging room. Our sommelier pours and talks you through the wine.',
    arch: true,
  },
  {
    id: 'buyout',
    name: 'The whole restaurant',
    photo: 'private-buyout',
    seated: 'Up to 70 seated',
    standing: '120 standing',
    minimum: 'Ask for pricing',
    text: 'Every room, the bar and the fire, for weddings, launches and company parties. Available Sunday to Thursday.',
    arch: false,
  },
];
---

<Base title="Private dining" description="Private dining rooms for 8 to 120 guests at Alder & Ash in Pioneer Square, Seattle.">
  <header class="page-head wrap">
    <h1 class="display" data-reveal>Private dining</h1>
    <p class="lede muted" data-reveal>
      Two private rooms and a full buyout, with set menus built around the fire. Our events team
      replies to every inquiry within one business day.
    </p>
  </header>

  <section class="wrap rooms" aria-label="Rooms">
    {
      rooms.map((room, i) => (
        <article class:list={['room', { 'room--wide': !room.arch, 'room--flip': i % 2 === 1 }]} id={room.id}>
          <div class:list={['room__photo', { arch: room.arch }]} data-unveil>
            <Photo name={room.photo} alt={`${room.name}, set for a private dinner`} sizes={room.arch ? '(min-width: 60rem) 36vw, 90vw' : '(min-width: 82rem) 76rem, 100vw'} />
          </div>
          <div class="room__copy">
            <h2 class="h1" data-reveal>{room.name}</h2>
            <p class="muted prose" data-reveal>{room.text}</p>
            <dl class="room__facts" data-reveal>
              <div>
                <dt>Capacity</dt>
                <dd>
                  {room.seated}
                  {room.standing && <><br />{room.standing}</>}
                </dd>
              </div>
              <div>
                <dt>Food and drink minimum</dt>
                <dd>{room.minimum}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section inquiry" aria-labelledby="inquiry-title" id="inquire">
    <div class="wrap inquiry__grid">
      <div class="inquiry__intro">
        <h2 id="inquiry-title" class="h1" data-reveal>Tell us about your event</h2>
        <p class="muted" data-reveal>
          Share a few details and we’ll send back availability, sample menus and pricing. You can
          also email <a class="link" href={`mailto:${site.eventsEmail}`}>{site.eventsEmail}</a>.
        </p>
      </div>

      <div class="inquiry__panel">
        <form class="form" data-validate data-event-form>
          <div class="form-row">
            <div class="field">
              <label for="ev-name">Full name</label>
              <input id="ev-name" name="name" type="text" autocomplete="name" required data-label="Your name" aria-describedby="ev-name-error" />
              <span class="error" id="ev-name-error" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="ev-company">Company <span class="muted">(optional)</span></label>
              <input id="ev-company" name="company" type="text" autocomplete="organization" />
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="ev-email">Email</label>
              <input id="ev-email" name="email" type="email" autocomplete="email" inputmode="email" required data-label="Your email" aria-describedby="ev-email-error" />
              <span class="error" id="ev-email-error" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="ev-phone">Phone</label>
              <input id="ev-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9\s\(\)\+\.\-]{10,}" data-label="Your phone number" data-msg-pattern="Enter a phone number with area code." aria-describedby="ev-phone-error" />
              <span class="error" id="ev-phone-error" aria-live="polite"></span>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="ev-date">Preferred date</label>
              <input id="ev-date" name="date" type="date" required data-msg-required="Choose a date." aria-describedby="ev-date-error" />
              <span class="error" id="ev-date-error" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="ev-guests">Guests</label>
              <input id="ev-guests" name="guests" type="number" inputmode="numeric" min="2" max="120" required data-label="The number of guests" data-msg-range="Enter between 2 and 120 guests." aria-describedby="ev-guests-error" />
              <span class="error" id="ev-guests-error" aria-live="polite"></span>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="ev-room">Room</label>
              <select id="ev-room" name="room">
                <option value="">Not sure yet</option>
                {rooms.map((r) => <option value={r.id}>{r.name}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="ev-type">Type of event</label>
              <select id="ev-type" name="type">
                <option>Dinner</option>
                <option>Reception</option>
                <option>Rehearsal dinner</option>
                <option>Wedding</option>
                <option>Company event</option>
                <option>Other</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="ev-message">Anything else we should know? <span class="muted">(optional)</span></label>
            <textarea id="ev-message" name="message" rows="4"></textarea>
          </div>
          <div>
            <button type="submit" class="btn" data-busy="Sending…">Send inquiry</button>
          </div>
        </form>

        <div class="success" data-success hidden>
          <h2 class="h2" tabindex="-1">Inquiry sent</h2>
          <p class="muted">
            Thank you, <span data-echo="name"></span>. Our events team will reply to
            <span data-echo="email"></span> within one business day with availability and menus.
          </p>
          <div class="actions">
            <button type="button" class="btn btn--ghost" data-reset-form>Send another inquiry</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initForms } from '../scripts/forms';
  const date = document.querySelector<HTMLInputElement>('#ev-date')!;
  const d = new Date();
  date.min = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  initForms(() => {
    date.setCustomValidity(date.value && date.value < date.min ? 'Choose today or a later date.' : '');
  });
</script>

<style>
  .rooms {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }
  .room {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .room {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 8vw, 8rem);
    }
    .room--flip .room__photo {
      order: 2;
    }
    .room--wide {
      grid-template-columns: 1fr;
    }
    .room--wide .room__copy {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 8vw, 8rem);
    }
    .room--wide .room__copy h2 {
      grid-row: span 2;
    }
  }
  .room__photo.arch {
    max-width: 28rem;
    width: 100%;
  }
  .room__copy {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  .room__facts {
    border-top: 1px solid var(--line);
  }
  .room__facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .room__facts dt {
    color: var(--smoke);
  }
  .room__facts dd {
    text-align: right;
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .inquiry {
    background: var(--oak);
  }
  .inquiry__grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .inquiry__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }
  }
  .inquiry__intro {
    display: grid;
    gap: var(--space-m);
  }
  .inquiry__panel {
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--soot);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .success {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .success h2:focus {
    outline: none;
  }
</style>
