---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';

const { lat, lng } = site.geo;
const d = 0.004;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - d},${lat - d / 2},${lng + d},${lat + d / 2}&layer=mapnik&marker=${lat},${lng}`;
---

<Base title="Visit" description="Hours, address, parking and directions for Alder & Ash at 200 Occidental Ave S in Pioneer Square, Seattle.">
  <header class="page-head wrap">
    <h1 class="display" data-reveal>Visit</h1>
    <p class="lede muted" data-reveal>
      On the brick-paved stretch of Occidental Avenue, between Main and Jackson, a block from the
      stadiums.
    </p>
  </header>

  <div class="wrap visit">
    <div class="visit__info">
      <section aria-labelledby="hours-title">
        <h2 id="hours-title" class="h3">Hours</h2>
        <dl class="list">
          {
            site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="muted small note">{site.barNote}</p>
      </section>

      <section aria-labelledby="addr-title">
        <h2 id="addr-title" class="h3">Address</h2>
        <address>
          {site.address.street}<br />
          {site.address.city}, {site.address.region} {site.address.postal}
        </address>
        <div class="actions">
          <a class="btn" href={site.mapsUrl} target="_blank" rel="noopener">Get directions</a>
          <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phone}</a>
        </div>
      </section>

      <section aria-labelledby="getting-title">
        <h2 id="getting-title" class="h3">Getting here</h2>
        <dl class="getting">
          <div>
            <dt>Parking</dt>
            <dd class="muted">{site.parking}</dd>
          </div>
          <div>
            <dt>Transit</dt>
            <dd class="muted">{site.transit}</dd>
          </div>
          <div>
            <dt>Game days</dt>
            <dd class="muted">
              When the Mariners, Seahawks or Sounders play at home, streets fill up two hours before
              the game. Give yourself extra time, or take the train.
            </dd>
          </div>
          <div>
            <dt>Access</dt>
            <dd class="muted">
              Step-free entrance on Occidental, with an elevator down to the Cellar and accessible
              restrooms on the main floor.
            </dd>
          </div>
        </dl>
      </section>
    </div>

    <div class="visit__side">
      <div class="map" data-map>
        <div class="map__cover">
          <Photo name="building" alt="The brick building on Occidental Avenue at dusk" sizes="(min-width: 60rem) 45vw, 100vw" ratio={4 / 3} />
          <button type="button" class="btn map__btn" data-map-load data-src={mapSrc}>Show map</button>
        </div>
      </div>
      <p class="small muted">The map loads from OpenStreetMap when you open it.</p>

      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="h3">Contact</h2>
        <p><a class="link" href={`mailto:${site.email}`}>{site.email}</a> for general questions</p>
        <p><a class="link" href={`mailto:${site.eventsEmail}`}>{site.eventsEmail}</a> for private events</p>
      </section>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = btn.dataset.src!;
      frame.title = 'Map showing Alder & Ash on Occidental Avenue South';
      frame.loading = 'lazy';
      frame.className = 'map__frame';
      btn.closest('[data-map]')!.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .visit {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }
  @media (min-width: 60rem) {
    .visit {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }
    .visit__side {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  .visit__info {
    display: grid;
    gap: var(--space-xl);
  }
  .visit h2 {
    margin-bottom: var(--space-s);
  }
  .list {
    border-top: 1px solid var(--line);
  }
  .list div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .list dt {
    color: var(--smoke);
  }
  .list dd {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .note {
    margin-top: var(--space-s);
  }
  address {
    font-style: normal;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    margin-bottom: var(--space-m);
  }
  .getting {
    display: grid;
    gap: var(--space-m);
  }
  .getting dt {
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .getting dd {
    max-width: 34rem;
  }
  .visit__side {
    display: grid;
    gap: var(--space-s);
  }
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--oak);
  }
  .map__cover {
    position: relative;
    height: 100%;
  }
  .map__cover :global(.photo) {
    height: 100%;
    filter: brightness(0.7);
  }
  .map__btn {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
  }
  .map :global(.map__frame) {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.4) invert(0.92) hue-rotate(180deg) sepia(0.15);
  }
  .contact {
    margin-top: var(--space-l);
  }
  .contact p + p {
    margin-top: 0.4rem;
  }
</style>
