---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import type { PhotoName } from '../data/photos';
import { press, awards } from '../data/press';

const shots: { name: PhotoName; alt: string }[] = [
  { name: 'gallery-01', alt: 'A bartender pouring a stirred cocktail' },
  { name: 'gallery-02', alt: 'A shellfish tower on crushed ice' },
  { name: 'gallery-03', alt: 'A steak being carved at the table' },
  { name: 'gallery-04', alt: 'Split alder logs stacked beside the hearth' },
  { name: 'gallery-05', alt: 'The bar, with bottles lit from behind' },
  { name: 'gallery-06', alt: 'Shared sides on the table' },
  { name: 'gallery-07', alt: 'Red wine being decanted by candlelight' },
  { name: 'gallery-08', alt: 'Friends laughing over dinner' },
  { name: 'gallery-09', alt: 'The brass handle on the front door' },
  { name: 'gallery-10', alt: 'A baked Alaska being torched' },
  { name: 'gallery-11', alt: 'The restaurant’s windows glowing on a Pioneer Square street at night' },
  { name: 'gallery-12', alt: 'Embers in the hearth, close up' },
];
---

<Base title="Gallery and press" description="Photos from the dining room, bar and kitchen at Alder & Ash, plus press and awards.">
  <header class="page-head wrap">
    <h1 class="display" data-reveal>Gallery</h1>
    <p class="lede muted" data-reveal>The fire, the room and the people around the table.</p>
  </header>

  <section class="wrap" aria-label="Photos">
    <ul class="grid" role="list" data-gallery>
      {
        shots.map((s, i) => (
          <li data-reveal>
            <button type="button" class="grid__item" data-index={i} aria-label={`View larger: ${s.alt}`}>
              <Photo name={s.name} alt={s.alt} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" />
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <div class="lightbox__stage" data-stage></div>
    <p class="lightbox__caption" data-caption aria-live="polite"></p>
    <button type="button" class="lightbox__btn lightbox__close" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__prev" data-prev aria-label="Previous photo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__next" data-next aria-label="Next photo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </dialog>

  <section class="section press" id="press" aria-labelledby="press-title">
    <div class="wrap">
      <h2 id="press-title" class="h1" data-reveal>Press</h2>
      <ul class="quotes" role="list">
        {
          press.map((p) => (
            <li data-reveal>
              <blockquote>“{p.quote}”</blockquote>
              <p class="source">{p.source}, {p.year}</p>
            </li>
          ))
        }
      </ul>

      <h2 class="h2 awards__title" data-reveal>Awards</h2>
      <ul class="awards" role="list">
        {
          awards.map((a) => (
            <li data-reveal>
              <span class="awards__name">{a.title}</span>
              <span class="awards__by">{a.by}</span>
              <span class="awards__year">{a.year}</span>
            </li>
          ))
        }
      </ul>
      <p class="muted small press__contact">
        For press inquiries, email <a class="link" href="mailto:press@alderandash.example">press@alderandash.example</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const stage = dialog.querySelector<HTMLElement>('[data-stage]')!;
  const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-index]')];
  let index = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    index = (i + items.length) % items.length;
    const media = items[index].querySelector('.photo')!.cloneNode(true) as HTMLElement;
    // Load the largest available size in the viewer
    media.querySelectorAll('img, source').forEach((el) => el.setAttribute('sizes', '90vw'));
    media.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
    const alt = media.querySelector('img')?.alt ?? media.querySelector('[role="img"]')?.getAttribute('aria-label') ?? '';
    stage.replaceChildren(media);
    caption.textContent = `${alt} (${index + 1} of ${items.length})`;
  };

  items.forEach((btn, i) =>
    btn.addEventListener('click', () => {
      opener = btn;
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
  // Click on the backdrop closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === stage) dialog.close();
  });
  dialog.addEventListener('close', () => opener?.focus());

  // Swipe on touch screens
  let startX = 0;
  stage.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .grid {
    list-style: none;
    padding: 0;
    columns: 1;
    column-gap: var(--space-m);
  }
  @media (min-width: 40rem) {
    .grid {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .grid {
      columns: 3;
    }
  }
  .grid li {
    break-inside: avoid;
    margin-bottom: var(--space-m);
  }
  .grid__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
    border-radius: 4px;
    cursor: zoom-in;
  }
  .grid__item :global(.photo__media) {
    transition:
      transform 1s var(--ease-out),
      filter 0.6s var(--ease-out);
  }
  @media (hover: hover) {
    .grid__item:hover :global(.photo__media) {
      transform: scale(1.04);
      filter: brightness(1.08);
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0c0a08;
    color: var(--bone);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    animation: fade 0.35s var(--ease-out);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lightbox__stage {
    display: grid;
    place-items: center;
    padding: 4.5rem 1rem 0.5rem;
    min-height: 0;
  }
  .lightbox__stage :global(.photo) {
    max-height: calc(100dvh - 9rem);
    max-width: min(90vw, 80rem);
    height: auto;
    width: auto;
    min-width: min(80vw, 30rem);
    animation: fade 0.4s var(--ease-out);
  }
  .lightbox__caption {
    padding: 1rem var(--gutter) 1.5rem;
    text-align: center;
    color: var(--smoke);
    font-size: 0.95rem;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(21 17 14 / 0.7);
    transition: background-color 0.2s var(--ease-out);
  }
  .lightbox__btn:hover {
    background: rgb(237 228 214 / 0.12);
  }
  .lightbox__btn svg {
    width: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__prev {
    left: 1rem;
  }
  .lightbox__next {
    right: 1rem;
  }
  @media (max-width: 40rem) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }

  .press {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--line);
  }
  .quotes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .quotes {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-l);
    }
  }
  .quotes li {
    padding-top: var(--space-m);
    border-top: 1px solid var(--line-strong);
  }
  .quotes blockquote {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
  }
  .source {
    margin-top: var(--space-s);
    color: var(--brass);
    font-size: 0.95rem;
  }
  .awards__title {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-m);
  }
  .awards {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .awards li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem var(--space-m);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .awards li {
      grid-template-columns: 2fr 1.5fr auto;
      align-items: baseline;
    }
  }
  .awards__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .awards__by {
    color: var(--smoke);
    grid-row: 2;
  }
  @media (min-width: 48rem) {
    .awards__by {
      grid-row: auto;
    }
  }
  .awards__year {
    color: var(--brass);
    grid-row: 1;
    grid-column: 2;
  }
  @media (min-width: 48rem) {
    .awards__year {
      grid-column: 3;
    }
  }
  .press__contact {
    margin-top: var(--space-l);
  }
</style>
