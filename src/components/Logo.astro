---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 32 40" aria-hidden="true" focusable="false">
    <path d="M2 39V16a14 14 0 0 1 28 0v23" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path
      class="logo__flame"
      d="M16 33c-3.6 0-6-2.4-6-5.6 0-3.4 3-5 3.6-8.4 2.6 1.6 3.4 3.6 3.2 5.6 1-.6 1.8-1.8 2-3.2 2 1.6 3.2 3.6 3.2 6 0 3.2-2.4 5.6-6 5.6Z"
      fill="currentColor"></path>
  </svg>
  <span class="logo__word">Alder <span class="logo__amp">&amp;</span> Ash</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--bone);
  }
  .logo__mark {
    width: 1.35rem;
    height: auto;
    color: var(--brass);
  }
  .logo__word {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo__amp {
    font-style: italic;
    color: var(--brass);
  }
</style>
