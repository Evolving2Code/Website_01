---
// Renders the photo for a named slot, or a sized placeholder until one exists.
// Drop src/assets/photos/<name>.(jpg|jpeg|png|webp|avif) to fill a slot; the
// image is cropped to the slot's ratio and served as AVIF/WebP at several widths.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photoSlots, type PhotoName } from '../data/photos';

interface Props {
  name: PhotoName;
  alt: string;
  sizes?: string;
  class?: string;
  /** Overrides the slot's ratio, e.g. for a taller crop of the same photo. */
  ratio?: number;
  priority?: boolean;
  /** Extra attributes for the inner media element, used for animation hooks. */
  mediaAttrs?: Record<string, string>;
}

const {
  name,
  alt,
  sizes = '(min-width: 64rem) 50vw, 100vw',
  class: className,
  ratio = photoSlots[name].ratio,
  priority = false,
  mediaAttrs = {},
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
);
const match = Object.keys(files).find(
  (path) => path.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase() === name,
);
const image = match ? (await files[match]()).default : undefined;
const widths = [480, 768, 1080, 1440, 2000].filter((w) => !image || w <= image.width);
---

<div class:list={['photo', className]} style={`--ratio: ${ratio}`}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        widths={widths.length ? widths : [image.width]}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="photo__media"
        {...mediaAttrs}
      />
    ) : (
      <div class="photo__media photo__placeholder" role="img" aria-label={alt} {...mediaAttrs}>
        <span class="photo__label" aria-hidden="true">
          {name}
        </span>
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--oak);
  }
  .photo :global(.photo__media),
  .photo :global(picture),
  .photo :global(img) {
    width: 100%;
    height: 100%;
  }
  .photo :global(img) {
    object-fit: cover;
  }
  .photo__placeholder {
    display: grid;
    place-items: end start;
    padding: 1rem 1.25rem;
    background:
      radial-gradient(120% 80% at 50% 110%, rgb(224 119 58 / 0.22), transparent 60%),
      radial-gradient(90% 60% at 20% 0%, rgb(201 164 106 / 0.08), transparent 70%),
      linear-gradient(160deg, var(--oak-2), var(--oak) 55%, #1a140f);
  }
  .photo__label {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--smoke-dim);
    font-family: var(--font-body);
  }
</style>
